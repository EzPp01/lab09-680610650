{
  "extends": [
    "@tsconfig/node-lts/tsconfig.json",
    "@tsconfig/node-ts/tsconfig.json"
  ],
  "compilerOptions": {
    "types": [
      "node"
    ],
    "rootDir": ".",
    "outDir": "./dist",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@src/*": [
        "./src/*"
      ],
      "@db/*": [
        "./src/db/*"
      ],
      "@libs/*": [
        "./src/libs/*"
      ]
    }
  },
  "include": [
    "./src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}